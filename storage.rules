rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Members stage an upload under their own uid before a Cloud Function
    // moves it to Drive. Nobody reads staged files directly (not even the
    // uploader) — the Cloud Function uses the Admin SDK, which bypasses
    // these rules entirely.
    match /staging/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024;
      allow read: if false;
    }
  }
}
